# Copy to .env and fill in. Never commit .env.
PORT=4000

# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:5173

# Alpaca — keys from https://app.alpaca.markets (paper account keys work for both URLs below)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Trading API (account, orders, positions, market clock) — paper trading environment
ALPACA_API_URL=https://paper-api.alpaca.markets/v2
# Market data API (prices, snapshots, bars) — same host for paper and live accounts
ALPACA_DATA_URL=https://data.alpaca.markets
# iex = free plan (real-time, IEX exchange only) · sip = all US exchanges (paid plan)
ALPACA_FEED=iex

# Real-time WebSocket stream (defaults to ALPACA_FEED).
# Set ALPACA_STREAM_FEED=test and subscribe to FAKEPACA to get fake trades 24/7 for testing.
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2
ALPACA_STREAM_FEED=

# Forex history — free key from https://twelvedata.com/pricing (8 requests/min, 800/day)
TWELVEDATA_API_KEY=
# Raise this if you upgrade your Twelve Data plan
TWELVEDATA_CREDITS_PER_MIN=8

# Forex live prices — free key from https://finnhub.io/register
FINNHUB_API_KEY=
